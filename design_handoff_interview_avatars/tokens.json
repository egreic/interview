{
  "$schema": "piste-clair-tokens",
  "meta": {
    "piste": "Clair",
    "note": "Côté interviewé : accent.school est VARIABLE (extraite du site de chaque école). Côté Studio : accent fixe. Une seule famille typographique.",
    "demoSchool": { "name": "ESM Lyon", "accent": "#0E7C66" }
  },
  "color": {
    "bg": "#FFFFFF",
    "surface": "#F5F5F4",
    "border": "#ECEAE7",
    "borderSubtle": "#F0EFED",
    "ink": "#17181A",
    "inkSecondary": "#6E6F72",
    "inkMuted": "#A3A4A7",
    "inkFaint": "#C4C3C0",
    "accent": { "school": "#0E7C66", "tint": "#E8F3F0", "on": "#FFFFFF", "halo": "rgba(14,124,102,0.10)" },
    "studio": { "accent": "#F1662B", "tint": "#FEF0E8" },
    "success": "#0E8A5F", "successTint": "#E8F5EF",
    "warning": "#B45309", "warningTint": "#FDF3E7"
  },
  "font": {
    "family": "Figtree",
    "weights": [400, 500, 600, 700, 800],
    "display": { "size": 27, "weight": 800, "lineHeight": 1.12, "letterSpacing": "-0.02em" },
    "title": { "size": 24, "weight": 800, "lineHeight": 1.15, "letterSpacing": "-0.02em" },
    "section": { "size": 15, "weight": 700 },
    "body": { "size": 14, "weight": 500, "lineHeight": 1.55 },
    "bubble": { "size": 14.5, "weight": 500, "lineHeight": 1.45 },
    "label": { "size": 11, "weight": 700, "letterSpacing": "0.1em", "transform": "uppercase" },
    "caption": { "size": 12.5, "weight": 500 }
  },
  "radius": { "input": 12, "card": 16, "cardLg": 20, "bubble": 16, "bubbleTail": 6, "pill": 999 },
  "space": [4, 8, 12, 16, 20, 24, 28, 32, 40],
  "shadow": {
    "card": "0 2px 12px rgba(23,24,26,0.06)",
    "sheet": "0 -4px 20px rgba(23,24,26,0.07)",
    "modal": "0 8px 40px rgba(23,24,26,0.08)"
  },
  "component": {
    "ctaHeight": 52,
    "ctaSecondaryHeight": 46,
    "hitTargetMin": 44,
    "progressDash": { "width": 22, "height": 6, "gap": 4 }
  }
}
