# Committed dev defaults — NO secrets here. Machine-specific overrides go in
# .env.local (git-ignored); test overrides live in .env.test.
APP_ENV=dev
APP_SECRET=dev-secret-change-me

MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB=interview

# Magic links (interviewee auth) — signing secret, dev value only
MAGIC_LINK_SECRET=dev-magic-link-secret-change-me

# studizz-auth (Studio admins + technical accounts). Trailing slash matters.
STUDIZZ_AUTH_URL=https://rancher.studizz.fr/studizz-auth/
STUDIZZ_AUTH_KEY=dev-api-key-change-me
# dev|test use the stub client; set to "http" when a real instance is reachable
STUDIZZ_AUTH_CLIENT=stub

# Async gateway (JobDispatcher implementation) — stub in dev until wired
STUDIZZ_API_AMQP_URL=http://localhost:8091

# Transactional mail gateway
STUDIZZ_API_MAILER_URL=http://localhost:8092

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
