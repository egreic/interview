# Shared docker-compose project name (keeps container names predictable)
COMPOSE_PROJECT_NAME=interview

# Dev credentials used by docker-compose. Override per-service in
# backend/.env.local, workers/.env and voice-gateway/.env.
MONGO_INITDB_DATABASE=interview
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Host ports exposed by docker-compose. Change these if another project (or a
# host service) already uses the default. Only the host side changes; the
# containers keep their standard internal ports.
INTERVIEWEE_PORT=5173
STUDIO_PORT=5174
BACKEND_PORT=8080
VOICE_GATEWAY_PORT=8000
MONGO_PORT=27017
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
REDIS_PORT=6379
