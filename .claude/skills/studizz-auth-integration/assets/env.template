# Studizz Auth integration

# Base URL of the studizz-auth service. The trailing slash is required —
# relative paths in the client are joined to this value.
# In production this points at the deployed studizz-auth instance; in local
# dev, typically a local PHP server.
STUDIZZ_AUTH_URL=http://localhost/studizz-auth/public/

# API key issued by studizz-auth that identifies your project to the auth
# service. Sent in the `x-api-key` header on every outbound request.
# Server-side only — never expose this to a browser or mobile client.
STUDIZZ_AUTH_KEY=
